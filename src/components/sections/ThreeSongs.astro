---
// (3) Printed spectrograms with playable recordings. Audio: public/audio, images: public/spectrograms
import PlayIcon from '../PlayIcon.astro';
import SectionNumber from '../SectionNumber.astro';
import { sectionTitle } from '../../site.config.js';
const id = 'listen-sec';
// Each recording: key matches public/audio/<key>.mp3 and public/spectrograms/<key>.png
const songs = [
  { key: 'blue', name: 'Blue Tit', sci: 'Cyanistes caeruleus', when: '22 September at 07:29' },
  { key: 'great', name: 'Great Tit', sci: 'Parus major', when: '22 September at 10:11' },
  { key: 'coal', name: 'Coal Tit', sci: 'Periparus ater', when: '22 September at 11:13' },
];
---
<section class="panel listen" id={id} aria-labelledby="h-listen">
  <canvas class="art cut" id="cv-listen" aria-hidden="true"></canvas>
  <div class="gutter" style="position:relative">
    <SectionNumber id={id} />
    <h2 id="h-listen" class="ink">{sectionTitle(id)}</h2>
    <p class="prose ink">Three bird songs from 22 September, each fifteen seconds long. Lower frequency background noise has been filtered out, allowing the bird song to be more clearly heard. Each picture is a spectrogram: time runs left to right, pitch rises up the page, and every mark is a note.</p>
    <div class="plates">
      {songs.map(s => (
        <figure class="plate" data-k={s.key}>
          <div class="plate-head">
            <button type="button" class="play ink" data-play={s.key} aria-label={`Play the ${s.name.toLowerCase()} recording`}><PlayIcon /></button>
            <div class="ink"><div class="pnm">{s.name}</div><div class="psci"><i>{s.sci}</i>, {s.when}</div></div>
          </div>
          <div class="spec-wrap">
            <div class="khz ink" aria-hidden="true"><span style="top:10.5%">10 kHz</span><span style="top:52.6%">6</span><span style="top:94.7%">2</span></div>
            <div class="spec-slot" id={`spec-${s.key}`} role="img" aria-label={`Spectrogram of the ${s.name.toLowerCase()} recording`}><div class="playhead"></div></div>
          </div>
        </figure>
      ))}
    </div>
  </div>
</section>
