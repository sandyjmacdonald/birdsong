---
// (5) One thread per species, one bead per day. Chart: src/scripts/sections/threads.js, notes: src/scripts/story.js
import PhotoCredit from '../PhotoCredit.astro';
import SectionNumber from '../SectionNumber.astro';
import { sectionTitle } from '../../site.config.js';
const id = 'threads-sec';
---
<section class="panel threads" id={id} aria-labelledby="h-threads">
  <canvas class="art cut" id="cv-threads" aria-hidden="true"></canvas>
  <div class="gutter" style="position:relative">
    <SectionNumber id={id} />
    <h2 id="h-threads" class="ink">{sectionTitle(id)}</h2>
    <p class="prose ink">One line for each species heard five times or more, one circle for every day on which it was heard. The bigger the circle, the more that species sang that day.</p>
    <div class="loom-wrap"><div class="loom" id="loom"></div></div>
  </div>
  <PhotoCredit name="Davide Sibilio" />
</section>
